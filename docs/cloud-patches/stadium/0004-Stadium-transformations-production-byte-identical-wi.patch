index 00000000..52735992
--- /dev/null
+++ b/tests/test_stadium_transformation_gating.py
@@ -0,0 +1,33 @@
+"""Pokemon Stadium transformations stay off unless asked for: the API
+default, the Slippi patch byte's known bits, and replay-derived configs,
+which never transform a frozen Stadium (no game data needed)."""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+from melee_sim.config import MatchConfig
+from tools.validation import admission
+
+ROOT = Path(__file__).resolve().parents[1]
+FROZEN_PATCH = bytes.fromhex(
+    "c21d457800000003ffe008903d80801d618c4fd87d8903a64e80042048000000")
+
+
+def test_api_default_is_frozen():
+    assert MatchConfig().stadium_transformations is False
+
+
+def test_wire_bit_and_known_mask():
+    wire = (ROOT / "src/runtime/wire.h").read_text()
+    assert re.search(r"MSL_PATCH_STADIUM_TRANSFORMATIONS = 1 << 1,", wire)
+    assert re.search(r"MSL_PATCH_KNOWN = MSL_PATCH_FD_BACKGROUND_FROZEN \|\s*MSL_PATCH_STADIUM_TRANSFORMATIONS", wire)
+
+
+def test_replays_transform_only_unfrozen_stadium():
+    assert admission.stadium_transformations({"stage": 3}, {}) is True
+    assert admission.stadium_transformations({"stage": 3, "is_frozen_ps": True}, {}) is False
+    assert admission.stadium_transformations({"stage": 3}, {0xC21D4578: FROZEN_PATCH}) is False
+    for stage in (2, 8, 28, 31, 32):
+        assert admission.stadium_transformations({"stage": stage}, {}) is False
diff --git a/tools/validation/admission.py b/tools/validation/admission.py
index 31c5c48c..62b135e9 100644
--- a/tools/validation/admission.py
+++ b/tools/validation/admission.py
@@ -78,6 +78,13 @@ def stadium_is_frozen(start: dict, codes: dict[int, bytes]) -> bool:
     return start.get("is_frozen_ps") is True or legacy_frozen
 
 
+def stadium_transformations(start: dict, codes: dict[int, bytes]) -> bool:
+    """Whether a replay's Pokemon Stadium transforms: only on Stadium, and
+    never when the capture says the stage is frozen (is_frozen_ps or the
+    legacy FreezeStadium patch). Every other replay runs as before."""
+    return start.get("stage") == 3 and not stadium_is_frozen(start, codes)
+
+
 # wire.h MSL_PATCH_*.
 PATCH_FD_BACKGROUND_FROZEN = 1 << 0
 
