diff --git a/tests/melee_core/stadium_defaults_smoke.c b/tests/melee_core/stadium_defaults_smoke.c
new file mode 100644
index 00000000..b4204432
--- /dev/null
+++ b/tests/melee_core/stadium_defaults_smoke.c
@@ -0,0 +1,94 @@
+// Pokemon Stadium transformations stay off for every config the base's
+// drivers build, Stadium or not (no game data needed):
+// - the public API's MslMatchConfig, set field by field over memory that is
+//   not zeroed (every byte, the struct's padding too, holds noise first), as
+//   a caller compiled against the base's api.h may leave it, then translated
+//   as msl_batch_reset translates it;
+// - the replay runner's wire config, built as tools/validation/native.c's
+//   build_match_config builds it from a replay (zeroed, the replay's Slippi
+//   patches from tools/validation/admission.py, which only ever sets
+//   MSL_PATCH_FD_BACKGROUND_FROZEN), then decoded as runtime/main.c decodes it.
+// Only an explicit request (the suite field, --stadium-transformations) sets
+// MSL_PATCH_STADIUM_TRANSFORMATIONS.
+
+#include "runtime/api_config.h"
+#include "runtime/wire.h"
+
+#include <stdio.h>
+#include <string.h>
+
+static int fail(const char* what, int stage, int noise)
+{
+    fprintf(stderr, "Stadium defaults: %s (stage %d, noise 0x%02x)\n", what, stage, noise);
+    return 1;
+}
+
+int main(void)
+{
+    static const int stages[] = { MSL_STAGE_FINAL_DESTINATION, MSL_STAGE_FOUNTAIN_OF_DREAMS,
+                                  MSL_STAGE_POKEMON_STADIUM };
+    static const int noises[] = { 0x00, 0x01, 0x02, 0x03, 0x7F, 0xA5, 0xFF };
+    size_t s, n;
+    int patches;
+
+    for (s = 0; s < sizeof(stages) / sizeof(stages[0]); ++s) {
+        for (n = 0; n < sizeof(noises) / sizeof(noises[0]); ++n) {
+            MslMatchConfig config;
+            MslMatchConfig defaults = msl_match_config_default();
+            MslCoreMatchConfig core;
+            uint32_t player;
+            // (the fields the base's api.h has, one by one, over noise)
+            memset(&config, noises[n], sizeof(config));
+            memset(&core, noises[n], sizeof(core));
+            config.stage = (uint32_t) stages[s];
+            config.random_seed = 1;
+            config.max_frame = -1;
+            config.damage_ratio = 1.0F;
+            config.num_players = 2;
+            config.is_teams = 0;
+            config.friendly_fire = 0;
+            config.stocks = 4;
+            config.viewpoint_player = 0;
+            config.ucf_cardinals = 1;
+            for (player = 0; player < MSL_MAX_PLAYERS; ++player) {
+                MslPlayerConfig* p = &config.players[player];
+                p->character = defaults.players[player].character;
+                p->team = MSL_TEAM_AUTO;
+                p->facing = MSL_FACING_AUTO;
+                p->controller_port = MSL_CONTROLLER_PORT_AUTO;
+                p->costume = 0;
+                p->handicap = 9;
+                p->start_percent = 0;
+            }
+            if (msl_api_translate_config(&config, &core) != 0) {
+                return fail("the API refused a base config", stages[s], noises[n]);
+            }
+            if (msl_core_config_stadium_transformations(&core)) {
+                return fail("the API turned transformations on", stages[s], noises[n]);
+            }
+            // (and the API's own default)
+            defaults.stage = (uint32_t) stages[s];
+            if (msl_api_translate_config(&defaults, &core) != 0 ||
+                msl_core_config_stadium_transformations(&core)) {
+                return fail("msl_match_config_default", stages[s], noises[n]);
+            }
+        }
+        for (patches = 0; patches <= MSL_PATCH_FD_BACKGROUND_FROZEN; ++patches) {
+            MslCoreMatchConfig built;
+            MslCoreMatchConfig decoded;
+            uint8_t wire[sizeof(MslCoreMatchConfig)];
+            memset(&built, 0, sizeof(built));
+            built.stage_id = (uint8_t) stages[s];
+            built.num_players = 2;
+            built.slippi_patches = (uint8_t) patches;
+            memcpy(wire, &built, sizeof(wire));
+            memset(&decoded, 0xFF, sizeof(decoded));
+            msl_core_decode_match_config(&decoded, wire);
+            if (msl_core_config_stadium_transformations(&decoded)) {
+                return fail("the runner's config turned transformations on", stages[s], patches);
+            }
+        }
+    }
+    printf("Stadium defaults: transformations stay off for the base's API and replay configs\n");
+    return 0;
+}
