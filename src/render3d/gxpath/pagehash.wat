(module
  (import "e" "m" (memory 0))
  ;; h(first, count, out): nothing written; returns page `first`'s 64-bit hash (count/out unused: one page a call)
  (func (export "h") (param $p i32) (result i64)
    (local $a i32) (local $end i32)
    (local $x v128) (local $y v128) (local $z v128) (local $w v128) (local $k v128)
    (local.set $a (i32.shl (local.get $p) (i32.const 16)))
    (local.set $end (i32.add (local.get $a) (i32.const 65536)))
    (local.set $x (v128.const i32x4 0x811c9dc5 0x01000193 0x9e3779b9 0x85ebca6b))
    (local.set $y (v128.const i32x4 0x27d4eb2d 0x165667b1 0xc2b2ae35 0x7feb352d))
    (local.set $z (v128.const i32x4 0x846ca68b 0x5bd1e995 0x2c1b3c6d 0x297a2d39))
    (local.set $w (v128.const i32x4 0x68e31da4 0xb5297a4d 0x1b56c4e9 0x9e6c63d0))
    (local.set $k (v128.const i32x4 16777619 16777619 16777619 16777619))
    (loop $l
      (local.set $x (i32x4.mul (v128.xor (local.get $x) (v128.load offset=0 (local.get $a))) (local.get $k)))
      (local.set $y (i32x4.mul (v128.xor (local.get $y) (v128.load offset=16 (local.get $a))) (local.get $k)))
      (local.set $z (i32x4.mul (v128.xor (local.get $z) (v128.load offset=32 (local.get $a))) (local.get $k)))
      (local.set $w (i32x4.mul (v128.xor (local.get $w) (v128.load offset=48 (local.get $a))) (local.get $k)))
      (local.set $a (i32.add (local.get $a) (i32.const 64)))
      (br_if $l (i32.lt_u (local.get $a) (local.get $end))))
    ;; the four vectors' lanes folded into two 64-bit words, then one: each step a multiply by an odd constant after an xor
    (local.set $x (i64x2.mul (v128.xor (local.get $x) (local.get $y)) (v128.const i64x2 0x9e3779b97f4a7c15 0xc2b2ae3d27d4eb4f)))
    (local.set $z (i64x2.mul (v128.xor (local.get $z) (local.get $w)) (v128.const i64x2 0x165667b19e3779f9 0xff51afd7ed558ccd)))
    (local.set $x (v128.xor (local.get $x) (i64x2.shr_u (local.get $z) (i32.const 29))))
    (local.set $x (i64x2.mul (v128.xor (local.get $x) (local.get $z)) (v128.const i64x2 0xc4ceb9fe1a85ec53 0x94d049bb133111eb)))
    (i64.xor (i64x2.extract_lane 0 (local.get $x)) (i64.rotl (i64x2.extract_lane 1 (local.get $x)) (i64.const 31))))
)
